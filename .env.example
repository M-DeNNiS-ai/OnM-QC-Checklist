PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Long random secret used only by the Battery QC server for its login session cookie.
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
SESSION_TTL=12h

# Supabase project settings.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# NEVER put this secret in public/index.html or any browser code.
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME

# Battery QC login PINs. Change these before production.
OMADMIN_PIN=1234
PLANT_PIN=2345
INVENTORY_PIN=3456
QUALITY_PIN=9999
STAGE1_PIN=1001
STAGE2_PIN=1002
STAGE3_PIN=1003
